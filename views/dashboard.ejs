<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>بوابة التقديمات</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#0d0e12] text-white font-sans min-h-screen flex flex-col md:flex-row">

    <!-- القائمة الجانبية -->
    <aside class="w-full md:w-72 bg-[#14161f] border-b md:border-b-0 md:border-l border-orange-500/10 p-6 flex flex-col justify-between shrink-0">
        <div>
            <div class="flex items-center gap-3 mb-8">
                <div class="w-12 h-12 bg-gradient-to-br from-orange-500 to-amber-600 rounded-2xl flex items-center justify-center font-bold text-black text-xl shadow-lg shadow-orange-500/20">🔥</div>
                <div>
                    <span class="font-bold text-xl text-orange-400 block">بوابة التقديم</span>
                    <span class="text-xs text-gray-500">لوحة التحكم</span>
                </div>
            </div>
            
            <nav class="space-y-3">
                <a href="/dashboard" class="flex items-center gap-3 bg-orange-500/10 text-orange-400 px-4 py-3 rounded-xl font-bold border border-orange-500/20">
                    🏠 القائمة الرئيسية
                </a>
            </nav>
        </div>

        <div class="flex items-center justify-between pt-6 mt-6 border-t border-gray-800">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-orange-500/20 border border-orange-500/30 flex items-center justify-center text-orange-400 font-bold">
                    <%= user.username.charAt(0) %>
                </div>
                <div class="overflow-hidden">
                    <h4 class="text-sm font-bold truncate w-28"><%= user.username %></h4>
                    <span class="text-xs text-orange-400/80">متقدم جديد</span>
                </div>
            </div>
            <a href="/logout" title="تسجيل خروج" class="text-red-400 hover:bg-red-500/10 p-2 rounded-lg transition">🚪</a>
        </div>
    </aside>

    <!-- المحتوى الرئيسي -->
    <main class="flex-1 p-6 md:p-12 overflow-y-auto space-y-10">
        
        <header class="bg-gradient-to-r from-orange-600/15 via-orange-600/5 to-transparent p-8 rounded-3xl border border-orange-500/20">
            <h1 class="text-3xl font-bold mb-3 text-orange-400">مرحباً بك ⛺</h1>
            <p class="text-gray-300 text-sm leading-relaxed max-w-2xl">اختر التقديم المناسب وقم بتعبئة النموذج بدقة.</p>
        </header>

        <!-- التقديمات -->
        <section class="space-y-6">
            <h2 class="text-xl font-bold text-gray-200">التقديمات المتاحة</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="bg-[#14161f] border border-orange-500/30 p-6 rounded-2xl flex flex-col justify-between space-y-6 shadow-lg shadow-orange-500/5">
                    <div class="space-y-3">
                        <span class="text-xs bg-emerald-500/10 text-emerald-400 px-3 py-1 rounded-full font-bold">مفتوح الآن</span>
                        <h3 class="text-xl font-bold text-white">إدارة ديسكورد</h3>
                        <p class="text-gray-400 text-xs leading-relaxed">انضم لطاقم الإدارة لتنظيم السيرفر والمساعدة.</p>
                    </div>
                    <button onclick="openForm()" class="w-full bg-orange-500 hover:bg-orange-600 text-black py-3 rounded-xl font-bold transition shadow-lg shadow-orange-500/20">تقديم الآن</button>
                </div>
            </div>
        </section>

    </main>

    <!-- نافذة الأسئلة (Modal) -->
    <div id="formModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm hidden flex items-center justify-center p-4 z-50">
        <div class="bg-[#14161f] border border-orange-500/30 rounded-3xl p-6 md:p-8 max-w-2xl w-full max-h-[90vh] overflow-y-auto space-y-6">
            
            <div class="flex justify-between items-center border-b border-gray-800 pb-4">
                <h3 class="text-xl font-bold text-orange-400">نموذج التقديم 📋</h3>
                <button onclick="closeForm()" class="text-gray-400 hover:text-white text-xl">✕</button>
            </div>

            <form action="/submit-application" method="POST" class="space-y-4 text-sm">
                <div>
                    <label class="block mb-1 text-gray-300">1. اسمك؟ كم عمرك؟</label>
                    <input type="text" name="q1" required class="w-full bg-[#0d0e12] border border-gray-800 rounded-xl p-3 text-white focus:border-orange-500 outline-none">
                </div>
                <div>
                    <label class="block mb-1 text-gray-300">2. ليش تبي تقدم في السيرفر؟</label>
                    <textarea name="q2" required rows="2" class="w-full bg-[#0d0e12] border border-gray-800 rounded-xl p-3 text-white focus:border-orange-500 outline-none"></textarea>
                </div>
                <div>
                    <label class="block mb-1 text-gray-300">3. ايش هدفك في السيرفر؟</label>
                    <textarea name="q3" required rows="2" class="w-full bg-[#0d0e12] border border-gray-800 rounded-xl p-3 text-white focus:border-orange-500 outline-none"></textarea>
                </div>
                <div>
                    <label class="block mb-1 text-gray-300">4. ايش رح تسوي للسيرفر؟</label>
                    <textarea name="q4" required rows="2" class="w-full bg-[#0d0e12] border border-gray-800 rounded-xl p-3 text-white focus:border-orange-500 outline-none"></textarea>
                </div>
                <div>
                    <label class="block mb-1 text-gray-300">5. اشرح خبراتك السابقة بإدارة ديسكورد؟</label>
                    <textarea name="q5" required rows="2" class="w-full bg-[#0d0e12] border border-gray-800 rounded-xl p-3 text-white focus:border-orange-500 outline-none"></textarea>
                </div>
                <div>
                    <label class="block mb-1 text-gray-300">6. بالشات, ايش رح تسوي؟ اذا شفت واحد يسوي spam؟</label>
                    <input type="text" name="q6" required class="w-full bg-[#0d0e12] border border-gray-800 rounded-xl p-3 text-white focus:border-orange-500 outline-none">
                </div>
                <div>
                    <label class="block mb-1 text-gray-300">7. لو شفت واحد يسب في شات, ايش رح تسوي؟</label>
                    <input type="text" name="q7" required class="w-full bg-[#0d0e12] border border-gray-800 rounded-xl p-3 text-white focus:border-orange-500 outline-none">
                </div>
                <div>
                    <label class="block mb-1 text-gray-300">8. لو شفت شخص ينتحل شخصية شخص اخر, ايش رح تسوي؟</label>
                    <input type="text" name="q8" required class="w-full bg-[#0d0e12] border border-gray-800 rounded-xl p-3 text-white focus:border-orange-500 outline-none">
                </div>
                <div>
                    <label class="block mb-1 text-gray-300">9. لو شفت شخص يعلن عن سيرفر اخر, ايش رح تسوي؟</label>
                    <input type="text" name="q9" required class="w-full bg-[#0d0e12] border border-gray-800 rounded-xl p-3 text-white focus:border-orange-500 outline-none">
                </div>
                <div>
                    <label class="block mb-1 text-gray-300">10. ايش رح تسوي لو شفت شخص يهدد شخص؟</label>
                    <textarea name="q10" required rows="2" class="w-full bg-[#0d0e12] border border-gray-800 rounded-xl p-3 text-white focus:border-orange-500 outline-none"></textarea>
                </div>

                <div class="flex gap-4 pt-4 border-t border-gray-800">
                    <button type="submit" class="flex-1 bg-orange-500 hover:bg-orange-600 text-black py-3 rounded-xl font-bold transition">إرسال التقديم</button>
                    <button type="button" onclick="closeForm()" class="bg-gray-800 text-gray-300 px-6 py-3 rounded-xl font-bold hover:bg-gray-700 transition">إلغاء</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openForm() {
            document.getElementById('formModal').classList.remove('hidden');
        }
        function closeForm() {
            document.getElementById('formModal').classList.add('hidden');
        }
    </script>

</body>
</html>